// Electioneering — Prisma schema
// Postgres-backed. Voter is primary entity; Form 20 feeds inference.

generator client {
  provider      = "prisma-client-js"
  // 'native' for local dev, 'rhel-openssl-3.0.x' for Vercel serverless runtime
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  Male
  Female
  Other
}

enum UploadStatus {
  processing
  validated
  failed
}

enum UploadKind {
  voter
  form20
}

enum Role {
  admin
  data_operator
}

// ─── User (auth) ─────────────────────────────────────────────────────────
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Election (per assembly constituency / contest) ─────────────────────
model Election {
  id              Int      @id @default(autoincrement())
  state           String
  parlNo          String
  parlName        String
  assemblyNo      String
  assemblyName    String
  assemblySeatType String?  // legislative assembly seat type (GEN / SC / ST)
  parlSeatType    String?   // loksabha seat type (GEN / SC / ST)
  electionType    String   @default("Assembly Election")
  electionYear    Int?
  totalElectors   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  candidates      Candidate[]
  booths          Booth[]
  boothVoters     BoothVoter[]

  @@unique([assemblyNo, assemblyName, electionYear])
  @@index([state])
}

// ─── Candidate (dynamic per election) ───────────────────────────────────
model Candidate {
  id          Int      @id @default(autoincrement())
  electionId  Int
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  name        String
  party       String?  // from master 'party' list
  alliance    String?  // from master 'alliance' list — per election (alliances shift)
  position    Int      @default(0) // column order in Form 20
  createdAt   DateTime @default(now())

  voteResults VoteResult[]

  @@index([electionId])
}

// ─── Polling Station (physical building / location, election-independent) ─
model PollingStation {
  id            Int      @id @default(autoincrement())
  code          String   @unique // in-house generated, deterministic — dedups buildings across elections
  name          String?
  address       String?
  cityVillage   String?  // city / village
  ward          String?  // ward no.
  tolaMohalla   String?  // tola / mohalla
  postOffice    String?
  policeStation String?
  assemblyNo    String?  // scope anchor for the code
  assemblyName  String?
  latitude      Float?   // geocoded from name/address
  longitude     Float?
  geocodedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  booths        Booth[]

  @@index([assemblyNo])
}

// ─── Booth (per-election polling booth; the Form 20 result row) ──────────
model Booth {
  id               Int      @id @default(autoincrement())
  electionId       Int
  election         Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  pollingStationId Int
  pollingStation   PollingStation @relation(fields: [pollingStationId], references: [id])
  serial           Int      // PS # in Form 20 (1..N) == roll Part Number
  name             String?  // booth / PS name as printed
  rejectedVotes    Int      @default(0)
  notaVotes        Int      @default(0)
  tenderedVotes    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  voteResults      VoteResult[]
  boothVoters      BoothVoter[]
  households       Household[]

  @@unique([electionId, serial])
  @@index([electionId])
  @@index([pollingStationId])
}

// ─── Vote results (cells in Form 20 grid) ───────────────────────────────
model VoteResult {
  id          Int   @id @default(autoincrement())
  boothId     Int
  candidateId Int
  votes       Int   @default(0)

  booth       Booth     @relation(fields: [boothId], references: [id], onDelete: Cascade)
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([boothId, candidateId])
  @@index([candidateId])
}

// ─── Household (per-election; voters often share one) ───────────────────
model Household {
  id          Int      @id @default(autoincrement())
  headName    String?
  headVoterId Int?     // Voter.id of the inferred household head (scalar, no FK)
  houseNumber String?  // makan
  assemblyNo  String?
  size        Int      @default(0)
  address     String?
  partNumber  String?
  boothId     Int?
  booth       Booth?   @relation(fields: [boothId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     BoothVoter[]

  @@index([partNumber])
  @@index([boothId])
  @@index([assemblyNo, partNumber, houseNumber])
}

// ─── Voter ──────────────────────────────────────────────────────────────
model Voter {
  id                 Int       @id @default(autoincrement())
  fullName           String?   // raw single-column name from the roll
  firstName          String
  lastName           String
  relationType       String?   // Father / Husband / Mother (from roll "Relation")
  relativeName       String?   // raw relative name from the roll
  relFirstName       String
  relLastName        String
  age                Int
  gender             Gender
  epic               String    @unique // EPIC No, e.g. TGK3378866 — stable mapping key across elections
  mobile             String?

  // Stable geography — administrative hierarchy that does not change per election.
  // Per-election roll position (pollingStation, partNumber, partSerial, houseNumber,
  // sectionNo/Name) lives on BoothVoter instead.
  state              String
  parlNo             String
  parlName           String
  assemblyNo         String
  assemblyName       String
  mainTown           String?
  ward               String?
  postOffice         String?
  policeStation      String?
  panchayat          String?
  block              String?
  tehsil             String?
  mandal             String?
  revenueDivision    String?
  subdivision        String?
  district           String?
  pinCode            String?

  // Segmentation attributes
  caste              String?   // specific caste / jati / sub-caste (open-ended)
  community          String?   // reservation class — Gen / OBC / SC / ST (fixed set)
  category           String?   // additional free-text classification
  religion           String?   // inferred from name (Hindu/Christian/Muslim/…)
  communityConfidence Float?   // 0..1 — confidence of the name-based inference
  communitySource    String    @default("inferred") // inferred | manual
  occupation         String?
  language           String?

  // Per-election inference output and roll position now live on BoothVoter.
  boothVoters        BoothVoter[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([assemblyNo, assemblyName])
  @@index([state])
  @@index([epic])
  @@index([caste])
  @@index([community])
  @@index([category])
  @@index([religion])
  @@index([occupation])
  @@index([ward])
  @@index([panchayat])
  @@index([block])
  @@index([tehsil])
  @@index([district])
}

// ─── BoothVoter (per-election voter↔booth roll entry) ───────────────────
// One row per (election, voter): where the voter is placed for that election,
// their roll position, the booth-derived predicted leaning, and their turnout.
model BoothVoter {
  id               Int      @id @default(autoincrement())
  electionId       Int      // denormalized for the (electionId, voterId) unique + fast filtering
  election         Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  boothId          Int
  booth            Booth    @relation(fields: [boothId], references: [id], onDelete: Cascade)
  voterId          Int
  voter            Voter    @relation(fields: [voterId], references: [id], onDelete: Cascade)

  // Per-election roll position (moved off Voter)
  partNumber       String?
  partName         String?
  partSerial       String?
  houseNumber      String?  // makan
  sectionNo        String?  // anubhag number
  sectionName      String?  // anubhag name

  // Statistical inference output (recomputed from Form 20)
  // shape: { byCandidate: { "Name": share, ... }, leader, leaderShare, totalValid }
  predictedLeaning Json?
  predictedAt      DateTime?

  // Turnout (merged from the old VoterTurnout model)
  voted            Boolean  @default(false)
  polledAt         DateTime?

  householdId      Int?
  household        Household? @relation(fields: [householdId], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([electionId, voterId])
  @@unique([boothId, voterId])
  @@index([boothId])
  @@index([voterId])
  @@index([householdId])
  @@index([electionId, voted])
}

// ─── Cohort (saved filter) ──────────────────────────────────────────────
model Cohort {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  // serialized filter spec — see services/segmentation.ts
  // shape example: { state, assemblyNo, age: { min, max }, gender, community, religion, occupation, leaningTo, polledIn?: [electionIds] }
  criteria    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

// ─── Upload history (audit trail for file uploads) ──────────────────────
model UploadHistory {
  id           Int          @id @default(autoincrement())
  fileName     String
  source       String       // e.g. "Excel · Officer L2"
  kind         UploadKind   // voter | form20
  records      Int          @default(0)
  constituency String?
  status       UploadStatus @default(processing)
  errorMsg     String?
  createdAt    DateTime     @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════
// Master data — referential lookup tables managed from the /all-master UI.
// Geography is a real hierarchy (Country → State → Parliamentary → Assembly);
// flat categorical sets (election type, party, community, …) live in the
// generic MasterCategory / MasterOption engine. Election/Voter keep their
// denormalized string fields; master feeds the dropdowns (non-breaking).
// ═══════════════════════════════════════════════════════════════════════

model Country {
  id        Int      @id @default(autoincrement())
  code      String   @unique // e.g. "IN"
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  states    State[]
}

model State {
  id        Int      @id @default(autoincrement())
  countryId Int
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code      String?  // e.g. "BR"
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parliamentaryConstituencies ParliamentaryConstituency[]

  @@unique([countryId, name])
  @@index([countryId])
}

model ParliamentaryConstituency {
  id        Int      @id @default(autoincrement())
  stateId   Int
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  number    String   // parlNo
  name      String   // parlName
  seatType  String?  // reservation (GEN / SC / ST) — from seat_type master
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assemblies AssemblyConstituency[]

  @@unique([stateId, number])
  @@index([stateId])
}

model AssemblyConstituency {
  id        Int      @id @default(autoincrement())
  parlId    Int
  parl      ParliamentaryConstituency @relation(fields: [parlId], references: [id], onDelete: Cascade)
  number    String   // assemblyNo
  name      String   // assemblyName
  seatType  String?  // reservation (GEN / SC / ST) — from seat_type master
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([parlId, number])
  @@index([parlId])
}

// Generic lookup engine — one category ("election_type", "party", …) owns many
// options. Add an entirely new list from the UI without a schema change.
model MasterCategory {
  id        Int      @id @default(autoincrement())
  key       String   @unique // stable slug, e.g. "election_type"
  label     String            // display, e.g. "Election Type"
  system    Boolean  @default(false) // system categories can't be deleted/renamed-key
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options   MasterOption[]
}

model MasterOption {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   MasterCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  code       String?
  label      String
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  meta       Json?    // optional extra attributes (e.g. party colour)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, label])
  @@index([categoryId])
}
